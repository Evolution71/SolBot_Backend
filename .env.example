# ---- Copy to .env and fill in. Never commit the real .env ----

# Database. Local dev can use SQLite; production must use Postgres (Supabase / Railway).
DATABASE_URL=sqlite:///./nexus.db
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Your Netlify site URL(s), comma separated, and the public URL used in referral links.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS KEY UP OFFLINE. If it is lost, every user's trading wallet is unrecoverable.
WALLET_ENCRYPTION_KEY=

# The account that registers with this email becomes the admin.
ADMIN_EMAIL=

# Wallet that receives plan payments and trading fees.
TREASURY_WALLET=469rxFHREhqpKcDBugswHFzvuCpuqzWhcSyWfvY8TrL3

# Use a paid RPC (Helius, QuickNode, Triton) in production. The public endpoint is rate limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Free key from https://developers.jup.ag/portal - required for live trading.
JUPITER_API_URL=https://api.jup.ag/swap/v2
JUPITER_API_KEY=

# true = simulated trading (safe). false = real swaps with real money.
PAPER_TRADING=true
PAPER_START_SOL=10

ENGINE_ENABLED=true
ENGINE_INTERVAL=6

REFERRAL_SHARE=0.20
REFERRAL_UNLOCK_COUNT=3
LAUNCH_PROMO_USERS=500
LAUNCH_PROMO_DAYS=7
